# ==============================================================================
# CareVoice AI - Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual API keys.
# 3. Never commit your real .env file with secrets into version control.
# ==============================================================================

# AssemblyAI API Key (Universal-3.5 Pro Realtime Streaming STT)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# OpenAI API Key (LLM - GPT-4.1-mini)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (TTS - Flash v2.5 - Optional/Legacy)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Deepgram API Key (TTS - Aura-2)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_TTS_MODEL=aura-2-helena-en

# n8n Appointment Availability Webhook URL (Dental Clinic Endpoint)
N8N_DENTAL_CHECK_AVAILABILITY_WEBHOOK_URL=http://localhost:5678/webhook/dental_check_appointment_availability

# n8n Clinic Appointment Webhook URL (Dental Booking, Rescheduling, Cancellation)
N8N_DENTAL_CLINIC_APPOINTMENT_WEBHOOK_URL=http://localhost:5678/webhook/dental-clinic-appointment

# Legacy/Fallback webhook variables
N8N_CHECK_APPOINTMENT_AVAILABILITY_WEBHOOK_URL=http://localhost:5678/webhook/dental_check_appointment_availability
N8N_CLINIC_APPOINTMENT_WEBHOOK_URL=http://localhost:5678/webhook/dental-clinic-appointment

# ElevenLabs Voice ID (Sophia voice)
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
