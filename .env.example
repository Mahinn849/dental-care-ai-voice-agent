# ==============================================================================
# CareVoice AI - Environment Variables Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (e.g. cp .env.example .env)
# 2. Replace placeholder values with your actual API keys.
# 3. Never commit your real .env file with secrets into version control.
# ==============================================================================

# AssemblyAI API Key (Universal-3.5 Realtime Streaming WebSocket STT)
ASSEMBLYAI_API_KEY="your_assemblyai_api_key_here"

# OpenAI API Key (LLM Reasoning & Function Calling - GPT-4o-mini)
OPENAI_API_KEY="your_openai_api_key_here"

# Cartesia API Key (Primary Ultra-Low Latency TTS - Sonic-2)
CARTESIA_API_KEY="your_cartesia_api_key_here"
CARTESIA_VOICE_ID="db6b0ed5-d5d3-463d-ae85-518a07d3c2b4"

# Fallback TTS Providers (Optional)
DEEPGRAM_API_KEY="your_deepgram_api_key_here"
DEEPGRAM_TTS_MODEL="aura-2-helena-en"
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="SAz9YHcvj6GT2YYXdXww"

